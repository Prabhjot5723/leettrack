# Copy this file to ".env" in the same folder and fill in your real values.
# .env is gitignored — never commit real passwords or secrets.

DB_HOST=localhost
DB_PORT=3306
DB_USER=leettrack_app
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=leetcode_tracker

# Random string, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE
JWT_EXPIRE_HOURS=24

# "development" (shows /docs) or "production" (hides /docs)
ENVIRONMENT=development

# Websites allowed to call this API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App timezone as minutes from UTC. 330 = India (IST).
APP_UTC_OFFSET_MINUTES=330

# Password-reset emails. Leave BREVO_API_KEY empty while testing on your own
# computer: the reset link is printed in the terminal instead of emailed.
FRONTEND_URL=http://localhost:5173
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=LeetTrack
